{
  "name": "dsh-browser-use",
  "version": "0.4.2",
  "description": "DSH bundle for the browser-use hub, domain, and browser backends",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "pack:bundle": "pnpm build && node scripts/pack-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "workspaces": ["packages/*/*"],
  "files": ["lib/index.js", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "browser-use": "workspace:^",
    "browser-use-chrome": "workspace:^",
    "browser-use-domain": "workspace:^",
    "browser-use-dege": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "chrome-devtools-mcp": "1.8.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
