{
  "name": "browser-use",
  "version": "0.3.0",
  "description": "Backend-neutral browser automation hub and DSH bundle",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./package.json": "./package.json" },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "packageManager": "pnpm@11.7.0",
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "browser-use-chrome": "workspace:^",
    "browser-use-domain": "workspace:^",
    "browser-use-dege": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-util-values": "0.1.2-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-util-values": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "chrome-devtools-mcp": "1.8.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}

