{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024"
    ],
    "paths": {
      "browser-use": [
        "./packages/browser-use/browser-use/src/index.ts"
      ],
      "browser-use-chrome": [
        "./packages/browser-use/browser-use-chrome/src/index.ts"
      ],
      "browser-use-domain": [
        "./packages/browser-use/browser-use-domain/src/index.ts"
      ],
      "browser-use-edge": [
        "./packages/browser-use/browser-use-edge/src/index.ts"
      ]
    }
  }
}
