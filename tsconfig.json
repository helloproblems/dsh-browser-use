{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "browser-use": ["packages/browser-use/browser-use/src/index.ts"],
      "browser-use-chrome": ["packages/browser-use/browser-use-chrome/src/index.ts"],
      "browser-use-domain": ["packages/browser-use/browser-use-domain/src/index.ts"],
      "browser-use-edge": ["packages/browser-use/browser-use-edge/src/index.ts"]
    }
  },
  "include": ["packages/*/*/src", "packages/*/*/tests"]
}
